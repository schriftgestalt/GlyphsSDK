S = TypeVar("S")
_ES = TypeVar("_ES")  # method-scoped element type, so factories can infer it from their argument

class NSOrderedSet(Generic[S], Sequence[S]):
	@overload
	def __init__(self) -> None: ...
	@overload
	def __init__(self, items: Iterable[S]) -> None: ...
	def __init__(self, items: Iterable[Any] | None = None) -> None: ...

	@classmethod
	def orderedSetWithArray_(cls, items: Iterable[_ES]) -> "NSOrderedSet[_ES]": ...

	# Core Objective-C API
	def count(self) -> int: ...
	def objectAtIndex_(self, index: int) -> S: ...
	def firstObject(self) -> S: ...
	def lastObject(self) -> S: ...
	def indexOfObject_(self, obj: S) -> int: ...  # NSNotFound if absent
	def containsObject_(self, obj: S) -> bool: ...
	# The set itself is not subscriptable; array() is the only indexed access.
	def array(self) -> "NSArray[Any]": ...

	# Python protocol methods
	def __len__(self) -> int: ...
	def __getitem__(self, index: int) -> S: ...
	def __iter__(self) -> Iterator[S]: ...

class NSMutableOrderedSet(NSOrderedSet[S]):
	# Narrowed from NSOrderedSet so the result stays mutable while keeping S.
	@classmethod
	def orderedSetWithArray_(cls, items: Iterable[_ES]) -> "NSMutableOrderedSet[_ES]": ...
	@classmethod
	def orderedSetWithCapacity_(cls, capacity: int) -> Self: ...

	# Adding & replacing
	def addObject_(self, obj: S) -> None: ...
	def addObjectsFromArray_(self, objects: Iterable[S]) -> None: ...
	def insertObject_atIndex_(self, obj: S, index: int) -> None: ...
	def setObject_atIndex_(self, obj: S, index: int) -> None: ...
	def replaceObjectAtIndex_withObject_(self, index: int, obj: S) -> None: ...

	# Reordering
	def exchangeObjectAtIndex_withObjectAtIndex_(self, idx1: int, idx2: int) -> None: ...
	def moveObjectsAtIndexes_toIndex_(self, indexes: "NSIndexSet", index: int) -> None: ...
	def sortUsingDescriptors_(self, descriptors: Iterable[Any]) -> None: ...

	# Removing
	def removeObject_(self, obj: S) -> None: ...
	def removeObjectAtIndex_(self, index: int) -> None: ...
	def removeObjectsInArray_(self, objects: Iterable[S]) -> None: ...
	def removeAllObjects(self) -> None: ...

	# Set operations, all in place
	def unionOrderedSet_(self, other: "NSOrderedSet[S]") -> None: ...
	def minusOrderedSet_(self, other: "NSOrderedSet[S]") -> None: ...
	def intersectOrderedSet_(self, other: "NSOrderedSet[S]") -> None: ...
	def unionSet_(self, other: set[S]) -> None: ...
	def minusSet_(self, other: set[S]) -> None: ...
	def intersectSet_(self, other: set[S]) -> None: ...


