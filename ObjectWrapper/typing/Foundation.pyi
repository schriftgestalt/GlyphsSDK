_FieldT = TypeVar("_FieldT")

class _NSStruct(Generic[_FieldT]):
	"""A mutable PyObjC struct; indexable & iterable over its fields."""
	def __getitem__(self, key: int) -> _FieldT: ...
	def __len__(self) -> int: ...

class NSPoint(_NSStruct[float]):
	"""A point (x & y)."""
	x: float
	y: float
	def __init__(self, x: float = ..., y: float = ...) -> None: ...

NSPointLike: TypeAlias = "NSPoint | tuple[float, float]"

class NSSize(_NSStruct[float]):
	"""A size (width & height)."""
	width: float
	height: float
	def __init__(self, width: float = ..., height: float = ...) -> None: ...

NSSizeLike: TypeAlias = "NSSize | tuple[float, float]"

class NSRect(_NSStruct["NSPoint | NSSize"]):
	"""A rectangle, defined by origin & size."""
	origin: NSPoint
	size: NSSize
	def __init__(self, origin: NSPointLike = ..., size: NSSizeLike = ...) -> None: ...
	@overload
	def __getitem__(self, key: Literal[0]) -> NSPoint: ...
	@overload
	def __getitem__(self, key: Literal[1]) -> NSSize: ...
	def __iter__(self) -> Iterator[NSPoint | NSSize]: ...

NSRectLike: TypeAlias = "NSRect | tuple[NSPointLike, NSSizeLike]"

class NSRange(_NSStruct[int]):
	"""A range, defined by location & length."""
	location: int
	length: int
	def __init__(self, location: int = ..., length: int = ...) -> None: ...

NSRangeLike: TypeAlias = "NSRange | tuple[int, int]"

